{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticCommits",
        ":rebaseStalePrs",
        ":automergeBranch",
        ":label(dependencies)"
    ],
    "timezone": "Europe/Prague",
    "schedule": [
        "before 6am on monday"
    ],
    "prConcurrentLimit": 5,
    "packageRules": [
        {
            "description": "Auto-merge safe dependency updates after CI passes",
            "matchUpdateTypes": [
                "patch",
                "minor",
                "digest"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "description": "Keep majors manual",
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false
        },
        {
            "description": "Group GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions"
        },
        {
            "description": "Group NuGet updates",
            "matchManagers": [
                "nuget"
            ],
            "groupName": "nuget"
        }
    ]
}
